# Required: long random value used to sign sessions
SECRET_KEY=
# Required once Odoo connectors are used: Fernet key for per-company API keys
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

FRONTEND_BASE_URL=http://localhost:8081
BACKEND_BASE_URL=http://localhost:8081
COOKIE_SECURE=false

# Local testing only: when no email could be sent (SMTP blank), show verification, password-reset
# and invite links on screen instead. MUST be false (or removed) on any public server.
EMAIL_LINK_FALLBACK=true

# Optional: email (verification, invites, password reset). Blank = links are shown to copy instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
